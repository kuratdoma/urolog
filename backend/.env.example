# ============================================================
# UroLOG — Örnek Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env
#
# .env dosyası git'e commit edilmez (.gitignore'da mevcut).
# Versiyon takibi için GitHub Releases/Tags kullanın.
# ============================================================

# --- GENEL ---
PROJECT_NAME=urolog
ENVIRONMENT=development        # development | production

# --- VERİTABANI ---
DB_USER=emr_admin
DB_PASSWORD=                   # openssl rand -hex 16
DB_NAME=urolog
DB_HOST=db                     # Docker içinde: db | Lokalde: localhost
DB_PORT=5432
DB_PORT_EXTERNAL=5432          # Docker dışına açılan port (docker-compose)

# --- REDIS ---
REDIS_HOST=redis               # Docker içinde: redis | Lokalde: localhost
REDIS_PORT=6379
REDIS_PASSWORD=                # openssl rand -hex 16

# --- GÜVENLİK (JWT) ---
# Üretmek için: openssl rand -hex 64
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_LONG_RANDOM_STRING
REFRESH_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_LONG_RANDOM_STRING

# --- BACKEND ---
BACKEND_PORT_EXTERNAL=8000

# --- EMAIL (SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=               # örn: noreply@klinigim.com
SMTP_FROM_NAME=UroLOG EMR

# --- AI SCRIBE ---
AI_SCRIBE_ENABLED=true
GOOGLE_API_KEY=                # Google AI Studio'dan alın
AI_SCRIBE_MODEL=gemini-2.5-flash-lite

# --- GOOGLE CALENDAR ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- GITHUB (sistem güncelleme) ---
# GitHub repo: kullanici_adi/repo_adi formatında
GITHUB_REPO=kuratdoma/urolog
GITHUB_TOKEN=                  # Özel repo ise kişisel erişim tokeni girin
GIT_SHA=latest

# --- SEED (ilk kullanıcı oluşturma) ---
# python scripts/master_seed.py çalıştırmadan önce tanımlayın
SEED_USER_PASSWORD=
SEED_USER_EMAIL=

# --- CORS / ALLOWED ORIGINS ---
# Klinik ağındaki sunucu/IP adresleri buraya girer (virgülle ayrılmış)
# Örn: https://192.168.1.99,http://192.168.1.99:3000,https://100.x.x.x
ALLOWED_ORIGINS=
# next.config.ts Access-Control-Allow-Origin header değeri
ALLOWED_ORIGIN_HEADER=http://localhost:3000
