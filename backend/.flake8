[flake8]
max-line-length = 88
extend-ignore =
    E203,
    W503,
    E712,
    E501,
    E402,
    E722,
    F403
per-file-ignores =
    __init__.py:F401,F403
    app/schemas/finance_schemas.py:F811
    # SQLAlchemy/Alembic model kaydı: importlar yan etki içindir, kullanılmamaları normal.
    app/db/base.py:F401
